# Copy this file to .env, then set the key locally. Do not share or commit the key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Optional. Unset uses medium, the current M2 setting; an explicit blank keeps the model's default.
# Values: none, low, medium, high, xhigh, max. Support depends on the model.
OPENAI_REASONING_EFFORT=medium

# Optional. Public GitHub issues work without a token, with lower GitHub API limits.
# Use a fine-grained token with "Public repositories" read-only access. With a token set,
# the Worker refuses repositories that GitHub does not report as public.
GITHUB_TOKEN=

# Optional GitHub sign-in. Set all three together with DATABASE_URL.
# Register the frontend callback, for example http://127.0.0.1:3000/api/v1/auth/github/callback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=

# Optional. A configured URL enables durable analysis records; blank uses memory.
# PostgreSQL is local to this example. Never commit real database credentials.
DATABASE_URL=postgresql://issuelens@127.0.0.1:5432/issuelens

# Local agent budgets. These are application limits, not provider limits.
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_CALLS=15
AGENT_RUNTIME_SECONDS=90
AGENT_CONTEXT_TOKENS=24000
AGENT_MAX_CANDIDATES=20
AGENT_MAX_CANDIDATE_READS=5
